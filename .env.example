# Database Configuration (Docker local setup)
DATABASE_URL="postgresql://postgres:postgres@localhost:5440/nexasupport?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-replace-me"

# AI Configuration
# Set to "mock" for local DB RAG queries, or "live" to use the NVIDIA API
AI_MODE="mock"

# External API Keys (Required if AI_MODE="live")
NVIDIA_API_KEY="your-nvidia-api-key-here"

# App Branding
NEXT_PUBLIC_APP_NAME="NexaSupport AI"
